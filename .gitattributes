# Ant-Code is first-party TaxaMask Agent Center source. The directory name is
# kept for runtime/package layout compatibility, but GitHub Linguist should not
# treat it as third-party vendored code in repository language statistics.
vendor/ant-code/** -linguist-vendored

# Windows command interpreters require CRLF in batch entrypoints.
*.bat text eol=crlf
*.cmd text eol=crlf
