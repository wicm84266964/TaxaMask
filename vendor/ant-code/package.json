{
  "name": "@ant-code/cli",
  "version": "2.0.5-taxamask.1",
  "description": "First-party Ant-Code Agent Center runtime embedded by TaxaMask.",
  "type": "module",
  "private": true,
  "bin": {
    "ant-code": "./src/cli/index.ts",
    "lab-agent": "./src/cli/index.ts"
  },
  "files": [
    "config/lab-agent.high-sensitivity-template.json",
    "config/lab-agent.lab-template.json",
    "config/skills/",
    "scripts/",
    "src/",
    "tests/",
    "npm-shrinkwrap.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.dashboard.json",
    "tsconfig.release-gates.json"
  ],
  "scripts": {
    "start": "node src/cli/index.ts",
    "doctor": "node src/cli/index.ts doctor",
    "mock-gateway": "node scripts/mock-gateway.ts",
    "check": "npm run check:syntax && npm test && npm run check:dashboard-assets",
    "check:syntax": "node scripts/check-syntax.ts",
    "check:dashboard-assets": "node scripts/check-dashboard-assets.ts",
    "verify:gateway": "node scripts/verify-gateway-compat.ts",
    "build:dashboard-assets": "node scripts/build-dashboard-assets.ts",
    "verify:release": "npm run check && npm run verify:gateway",
    "test": "node scripts/run-tests.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "ink": "^6.8.0",
    "katex": "^0.16.46",
    "mermaid": "^11.15.0",
    "react": "^19.2.5",
    "typescript": "6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "axe-core": "4.12.1",
    "esbuild": "^0.28.0",
    "playwright-core": "1.61.1",
    "postject": "^1.0.0-alpha.6"
  }
}
